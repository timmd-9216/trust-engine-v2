      "excludeFiles": "{.github/**,tests/**,docs/**,data/**,scripts/**,terraform/**,migrations/**,comparar/**,old/**,stanza_resources/**,htmlcov/**,src/trust_api/nlp/**,src/trust_api/vector_store/**,src/trust_api/services/**,src/trust_api/api/**,src/trust_api/core/**,src/trust_api/main.py,src/trust_api/models.py,src/script_processing/**,src/data_analysis/**,**/*.csv,**/*.parquet}"
